# Add to the bottom of /etc/samba/smb.conf on the Proxmox host (chapter 4).
# Then: smbpasswd -a root && systemctl restart smbd
[media]
   path = /mnt/media
   browseable = yes
   read only = no
   guest ok = no
   valid users = root
   # Not applied or tested on CommandCenter (chapter 7, bug 3):
   # inherit acls = yes
