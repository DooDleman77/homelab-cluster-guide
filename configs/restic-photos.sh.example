#!/bin/sh
# Back up the photo folder (a bind mount the nightly vzdump job SKIPS)
# to the OTHER drive with restic (chapter 9, step 4).
#
# HONEST STATUS: written up for Book 1, NEVER applied or tested on CommandCenter.
# Standard restic usage; test a restore before you trust it.
#
# One-time setup on the Proxmox host:
#   apt install restic
#   mkdir -p /mnt/backup/restic-immich
#   openssl rand -base64 32 > /root/.restic-pass && chmod 600 /root/.restic-pass
#   restic -r /mnt/backup/restic-immich --password-file /root/.restic-pass init
#   Keep a copy of /root/.restic-pass OFF the server. Without it the backup can't be opened.
#
# Nightly at 3:30 (crontab -e), one line:
#   30 3 * * * /root/restic-photos.sh
#
# Restore test:
#   restic -r /mnt/backup/restic-immich --password-file /root/.restic-pass restore latest --target /tmp/restore-test
REPO=/mnt/backup/restic-immich
PASS=/root/.restic-pass
restic -r "$REPO" --password-file "$PASS" backup /mnt/media/immich --quiet && \
restic -r "$REPO" --password-file "$PASS" forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune --quiet
