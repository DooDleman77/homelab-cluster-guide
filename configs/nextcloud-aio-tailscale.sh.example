#!/bin/sh
# Nextcloud All-in-One master container, reverse-proxy mode behind
# `tailscale serve` (chapter 8, step 7). Run INSIDE the Docker container.
# First: tailscale serve --bg http://127.0.0.1:11000
# If an earlier master container exists:
#   docker stop nextcloud-aio-mastercontainer && docker rm nextcloud-aio-mastercontainer
#   (settings and the passphrase live in the named volume and survive)
docker run \
  --init \
  --sig-proxy=false \
  --name nextcloud-aio-mastercontainer \
  --restart always \
  --publish 8080:8080 \
  --env APACHE_PORT=11000 \
  --env APACHE_IP_BINDING=127.0.0.1 \
  --env SKIP_DOMAIN_VALIDATION=true \
  --volume nextcloud_aio_mastercontainer:/mnt/docker-aio-config \
  --volume /var/run/docker.sock:/var/run/docker.sock:ro \
  -e NEXTCLOUD_DATADIR="/ncdata" \
  ghcr.io/nextcloud-releases/all-in-one:latest
# Then open https://<container-IP>:8080 and enter <container-name>.<your-tailnet>.ts.net as the domain.
